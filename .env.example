# Copy this file to .env.local and fill in the values after the "=".

# Google Maps API key for Google Photorealistic 3D Tiles (preferred).
# Enable "Map Tiles API" in Google Cloud, and restrict the key to that API
# and to your site's HTTP referrers: it is visible in the browser.
# When set, nothing is loaded from Cesium ion.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Cesium ion access token (https://ion.cesium.com/tokens). Only used when no
# Google key is set (World Terrain, Bing imagery, OSM Buildings).
NEXT_PUBLIC_CESIUM_ION_TOKEN=your-cesium-ion-token

# Laravel API base URL (server-side client in lib/api).
NEXT_PUBLIC_API_URL=https://traccar.sidratech.ae/api

# Laravel Reverb (realtime positions, alerts and notifications). The app key
# is public by design; channels are authorized through /api/broadcasting/auth.
# Leave the key empty to fall back to polling.
NEXT_PUBLIC_REVERB_APP_KEY=51a0dc8fe25a7a4070be
NEXT_PUBLIC_REVERB_HOST=realtime.sidratech.ae
NEXT_PUBLIC_REVERB_PORT=443
NEXT_PUBLIC_REVERB_SCHEME=https
