# Copy this file to .env.local and fill in the values after the "=".

# Google Maps API key for Google Photorealistic 3D Tiles (preferred).
# Enable "Map Tiles API" in Google Cloud, and restrict the key to that API
# and to your site's HTTP referrers: it is visible in the browser.
# When set, nothing is loaded from Cesium ion.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Cesium ion access token (https://ion.cesium.com/tokens). Only used when no
# Google key is set (World Terrain, Bing imagery, OSM Buildings).
NEXT_PUBLIC_CESIUM_ION_TOKEN=

# Laravel API base URL (server-side client in lib/api).
NEXT_PUBLIC_API_URL=https://api.example.com/api
